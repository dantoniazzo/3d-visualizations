node_modules
dist
.env
.env.local
.DS_Store
*.log

# Blender's own rolling backup of the last save.
*.blend1

# Build outputs. `npm run models` regenerates the Blender scene and its GLB;
# see README "Building the models".
blender/out/
public/models/wrenfield_furnishings.glb
public/models/kit.glb

# Published public views — written by the editor's Publish, one folder a space.
published/

# Generated furniture catalogue — `npm run furniture` rebuilds it.
public/models/furniture/*.glb


# Python's bytecode cache, which Blender writes beside the scripts it runs.
__pycache__/
*.pyc

# The cars as they came from Sketchfab: tens of megabytes each, and
# re-downloadable from the links in assets/cars/cars.json. What the app
# drives is built from them (`blender/import_cars.py`) into
# public/models/cars/, which is kept, with each model's credits.
assets/cars/*.glb
