# Required for AI scene generation (/api/generate).
# Get one at https://console.anthropic.com/ — or run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# Optional overrides
PORT=3000
# Model used for scene generation. Defaults to claude-opus-5.
SCENE_MODEL=claude-opus-5
# Reasoning depth for generation: low | medium | high | xhigh | max
SCENE_EFFORT=high
