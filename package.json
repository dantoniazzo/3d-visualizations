{
  "name": "space-walkthrough",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D property editor and walkthrough with multiplayer presence and chat",
  "scripts": {
    "frontend-dev": "vite --host",
    "frontend-build": "vite build --watch",
    "backend-build": "node server/index.js",
    "backend-dev": "nodemon server/index.js",
    "dev": "concurrently --kill-others \"npm run frontend-build\" \"npm run backend-dev\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node scripts/seed-scenes.js",
    "models": "node scripts/build-models.mjs",
    "upload-models": "node scripts/upload-models.mjs",
    "furniture": "node scripts/build-models.mjs --furniture",
    "props": "node scripts/build-models.mjs --props",
    "avatars": "node scripts/optimize-avatars.mjs",
    "people": "node scripts/optimize-people.mjs",
    "site-assets": "node scripts/fetch-site-assets.mjs",
    "trees": "node scripts/pack-trees.mjs",
    "bake": "node scripts/bake-public.mjs",
    "seats": "node scripts/measure-seats.mjs",
    "screens": "node scripts/measure-screens.mjs",
    "people:place": "node scripts/place-people.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "concurrently": "^8.2.0",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.2.0",
    "nodemon": "^3.1.0",
    "sass": "^1.71.0",
    "sharp": "^0.35.4",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "events": "^3.3.0",
    "express": "^4.19.2",
    "gsap": "^3.12.5",
    "n8ao": "^1.10.1",
    "nanoid": "^5.0.7",
    "nipplejs": "^0.10.2",
    "postprocessing": "^6.35.6",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "three": "^0.163.0"
  }
}
