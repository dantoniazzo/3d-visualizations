{
  "name": "space-walkthrough",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-generated 3D furnished space walkthrough visualizer with multiplayer presence and chat",
  "scripts": {
    "frontend-dev": "vite --host",
    "frontend-build": "vite build --watch",
    "backend-build": "node server/index.js",
    "backend-dev": "nodemon server/index.js",
    "dev": "concurrently --kill-others \"npm run frontend-build\" \"npm run backend-dev\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node scripts/seed-scenes.js",
    "models": "node scripts/build-models.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.1.0",
    "sass": "^1.71.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "events": "^3.3.0",
    "express": "^4.19.2",
    "gsap": "^3.12.5",
    "nanoid": "^5.0.7",
    "nipplejs": "^0.10.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "three": "^0.163.0"
  }
}
